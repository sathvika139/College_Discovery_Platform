generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model College {
  id         String      @id @default(cuid())
  name       String
  location   String
  fees       Int
  rating     Float
  createdAt  DateTime    @default(now())
  courses    Course[]
  placements Placement[]
  reviews    Review[]
}

model Course {
  id        String  @id @default(cuid())
  name      String
  duration  String
  collegeId String
  college   College @relation(fields: [collegeId], references: [id])
}

model Placement {
  id         String  @id @default(cuid())
  averageCTC Float
  highestCTC Float
  collegeId  String
  college    College @relation(fields: [collegeId], references: [id])
}

model Review {
  id        String  @id @default(cuid())
  userName  String
  comment   String
  rating    Float
  collegeId String
  college   College @relation(fields: [collegeId], references: [id])
}
